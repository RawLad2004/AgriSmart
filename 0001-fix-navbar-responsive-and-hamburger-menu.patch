+    .eq("slug", slug)
+    .eq("published", true)
+    .single();
+
+  if (error || !article) {
+    box.innerHTML = `<p>Article not found. <a href="articles.html">Back to Articles</a></p>`;
+    return;
+  }
+
+  document.getElementById("page-title").textContent = article.title + " | AgriSmart";
