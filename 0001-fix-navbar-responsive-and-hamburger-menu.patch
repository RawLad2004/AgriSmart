+/*==========================================================
+                        HEADER
+==========================================================*/
+
+header{
+
+    position:fixed;
+    top:0;
+    left:0;
+    width:100%;
+    z-index:1000;
+
+}
+
+/*==========================================================
+                        NAVBAR
+==========================================================*/
+
+.navbar{
+
+    display:flex;
+    justify-content:space-between;
+    align-items:center;
+
+    width:100%;
+    height:clamp(70px, 8vw, 90px);
+
+    padding:0 clamp(16px, 4vw, 50px);
+
+    background:rgba(255,255,255,.12);
+    backdrop-filter:blur(16px);
+    -webkit-backdrop-filter:blur(16px);
+
+    border-bottom:1px solid rgba(255,255,255,.2);
+
+    transition:.35s;
+
+}
+
+/*==========================================================
+                        LOGO
+==========================================================*/
+
+/*==============================
+        AGRISMART LOGO
+    Real logo image (images/logo-icon.png), not a
+    CSS-drawn placeholder. The .letter-a/.letter-s spans
+    are hidden but left in the HTML so no markup needs to
+    change across pages.
+==============================*/
+
+.logo{
+    display:flex;
+    align-items:center;
+    gap:12px;
+}
+
+.as-logo{
+    width:clamp(40px, 5vw, 55px);
+    height:clamp(40px, 5vw, 55px);
+    flex-shrink:0;
+    border-radius:50%;
+    background-color:#ffffff;
+    background-image:url('../images/logo-icon.png');
+    background-size:75%;
+    background-repeat:no-repeat;
+    background-position:center;
+    box-shadow:0 5px 15px rgba(0,0,0,.12);
+    transition:.35s;
+    cursor:pointer;
+}
+
+.letter-a,
+.letter-s{
+    display:none;
+}
+
+.logo h2{
+    font-size:clamp(18px, 2.2vw, 28px);
+    font-weight:700;
+    color:#222;
+    white-space:nowrap;
+}
+
+.as-logo:hover{
+    transform:rotate(-8deg) scale(1.1);
+    box-shadow:0 12px 25px rgba(0,0,0,.2);
+}
+/*==========================================================
+                    NAVIGATION LINKS
+==========================================================*/
+
+.nav-links{
+
+    display:flex;
+
+    gap:clamp(10px, 1.8vw, 25px);
+
+    flex-wrap:nowrap;
+
+}
+
+.nav-links a{
+
+    position:relative;
+
+    color:white;
+
+    font-size:clamp(.8rem, .95vw, 1rem);
+
+    font-weight:600;
+
+    white-space:nowrap;
+
+    transition:var(--transition-fast);
+
+}
+
+.nav-links a:hover{
+
+    color:var(--light-green);
+
+}
+
+.nav-links a::after{
+
+    content:"";
+
+    position:absolute;
+
+    left:0;
+
+    bottom:-8px;
+
+    width:0;
+
+    height:3px;
+
+    border-radius:20px;
+
+    background:var(--electric-blue);
+
+    transition:.35s;
+
+}
+
+.nav-links a:hover::after{
+
+    width:100%;
+
+}
+
+/*==========================================================
+                    BUTTON GROUP
+==========================================================*/
+
+.nav-buttons{
+
+    display:flex;
+
+    align-items:center;
+
+    flex-shrink:0;
+
+    gap:clamp(8px, 1.2vw, 15px);
+
+}
+
+/*==========================================================
+                    SEARCH BUTTON
+==========================================================*/
+
+.search-btn{
+
+    width:clamp(36px, 4vw, 45px);
+
+    height:clamp(36px, 4vw, 45px);
+
+    flex-shrink:0;
+
+    border-radius:50%;
+
+    background:rgba(255,255,255,.15);
+
+    color:white;
+
+    font-size:1rem;
+
+    transition:var(--transition-normal);
+
+}
+
+.search-btn:hover{
+
+    background:var(--electric-blue);
+
+    transform:rotate(12deg) scale(1.08);
+
+}
+
+/*==========================================================
+                    LOGIN BUTTON
+==========================================================*/
+
+.login-btn{
+
+    background:transparent;
+
+    color:white;
+
+    border:2px solid rgba(255,255,255,.4);
+
+    padding:clamp(8px, 1.2vw, 12px) clamp(14px, 2vw, 22px);
+
+    border-radius:40px;
+
+    font-size:clamp(.8rem, .95vw, 1rem);
+
+    font-weight:600;
+
+    white-space:nowrap;
+
+    transition:var(--transition-normal);
+
+}
+
+.login-btn:hover{
+
+    background:white;
+
+    color:var(--dark-green);
+
+}
+
+/*==========================================================
+                GET STARTED BUTTON
+==========================================================*/
+
+.start-btn{
+
+    background:var(--primary-gradient);
+
+    color:white;
+
+    padding:clamp(9px, 1.4vw, 14px) clamp(16px, 2.5vw, 28px);
+
+    border-radius:40px;
+
+    font-size:clamp(.8rem, .95vw, 1rem);
+
+    font-weight:700;
+
+    white-space:nowrap;
+
+    box-shadow:var(--shadow-small);
+
+    transition:var(--transition-normal);
+
+}
+
+.start-btn:hover{
+
+    transform:translateY(-4px);
+
+    box-shadow:var(--glow-blue);
+
+}
+
+/*==========================================================
+                    MOBILE MENU
+==========================================================*/
+
+.menu-toggle{
+
+    display:none;
+
+    align-items:center;
+
+    justify-content:center;
+
+    width:42px;
+
+    height:42px;
+
+    margin-left:10px;
+
+    font-size:1.4rem;
+
+    color:white;
+
+    background:transparent;
+
+    border:none;
+
+    cursor:pointer;
+
+    z-index:1100;
+
+}
+
+.menu-toggle .fa-xmark{
+
+    display:none;
+
+}
+
+.menu-toggle.active .fa-bars{
+
+    display:none;
+
+}
+
+.menu-toggle.active .fa-xmark{
+
+    display:block;
+
+}
+
+/*==========================================================
+                    NAVBAR ANIMATION
+==========================================================*/
+
+.navbar{
+
+    animation:slideDown .8s ease;
+
+}
+
+@keyframes slideDown{
+
+    from{
+
+        transform:translateY(-100%);
+
+        opacity:0;
+
+    }
+
+    to{
+
+        transform:translateY(0);
+
+        opacity:1;
+
+    }
+
+}
+
+/*==========================================================
+                    HOVER EFFECT
+==========================================================*/
+
+.logo:hover i{
+
+    transform:rotate(-10deg);
+
+    transition:.4s;
+
+}
+.footer-logo img{
+
+    width:220px;
+
+    margin-bottom:20px;
+
+}
+/*==========================================================
+                RESPONSIVE NAVBAR
+==========================================================*/
+
+@media (max-width:900px){
+
+    /* Sizing above this point is fluid (clamp-based), so the only
+       jump left is switching from the inline links/buttons layout
+       to the hamburger-driven dropdown below. */
+
+    .nav-links,
+    .nav-buttons{
+        display:none;
+    }
+
+    .menu-toggle{
+        display:flex;
+    }
+
+    /* header is position:fixed, so top:100% anchors this panel
+       to the bottom of the navbar automatically — no matter what
+       height the navbar happens to be at that viewport/zoom. */
+    .mobile-menu{
+
+        display:none;
+
+        position:absolute;
+
+        top:100%;
+
+        left:0;
+
+        width:100%;
+
+        max-height:calc(100vh - 100%);
+
+        overflow-y:auto;
+
+        flex-direction:column;
+
+        background:rgba(20,35,28,.97);
+        backdrop-filter:blur(16px);
+        -webkit-backdrop-filter:blur(16px);
+
+        padding:25px 20px 30px;
+
+        gap:25px;
+
+        align-items:center;
+
+    }
+
+    .mobile-menu.active{
+        display:flex;
+    }
+
+    .mobile-menu .nav-links{
+        display:flex;
+        flex-direction:column;
+        width:100%;
+        gap:18px;
+        align-items:center;
+    }
+
+    .mobile-menu .nav-links a{
+        font-size:1rem;
+    }
+
+    .mobile-menu .nav-buttons{
+        display:flex;
+        flex-direction:column;
+        width:100%;
+        max-width:280px;
+        gap:14px;
+        align-items:stretch;
+    }
+
+    .mobile-menu .nav-buttons .search-btn{
+        align-self:center;
+    }
+
+    .mobile-menu .login-btn,
+    .mobile-menu .start-btn{
+        width:100%;
+        text-align:center;
+        font-size:1rem;
+        padding:12px 22px;
+    }
+
+}
+
+@media (max-width:480px){
+
+    .navbar{
+        padding:0 15px;
+    }
+
 }
