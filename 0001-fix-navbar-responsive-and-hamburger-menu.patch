 articles.html  |  278 ++++++------
 css/navbar.css |  921 +++++++++++++++++++--------------------
 index.html     | 1129 ++++++++++++++++++++++++------------------------
 js/navbar.js   |   68 +++
 5 files changed, 1425 insertions(+), 1322 deletions(-)

