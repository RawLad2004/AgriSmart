+
+/*==========================================================
+                    ROOT VARIABLES
+==========================================================*/
+
+:root{
+
+    /*======================================================
+                        BRAND COLORS
+    ======================================================*/
+
+    --primary-green:#2E8B57;
+    --dark-green:#0B5D1E;
+    --light-green:#7ED957;
+
+    --dark-blue:#0F3D57;
