+}
+
+.secondary-btn:hover{
+
+    background:var(--primary-green);
+
+    color:white;
+
+}
+
+
+/*==========================================================
+                    CARDS
+==========================================================*/
+
+.service-card,
+.article-card{
+
+    background:white;
+
+    border-radius:25px;
+
+    padding:35px;
+
+    box-shadow:var(--shadow-small);
+
+    transition:var(--transition-normal);
+
+}
+
+.service-card:hover,
+.article-card:hover{
+
+    transform:translateY(-12px);
+
+    box-shadow:var(--shadow-medium);
+
+}
+
+
+/*==========================================================
+                    ICONS
+==========================================================*/
+
+.service-card i{
+
+    width:75px;
+
+    height:75px;
+
+    display:flex;
+
+    align-items:center;
+
+    justify-content:center;
+
+    border-radius:50%;
+
+    margin-bottom:25px;
+
+    background:var(--primary-gradient);
+
+    color:white;
+
+    font-size:2rem;
+
+}
+
+
+/*==========================================================
+                    SECTION TITLES
+==========================================================*/
+
+section h2{
+
+    position:relative;
+
+    display:inline-block;
+
+    left:50%;
+
+    transform:translateX(-50%);
+
+    margin-bottom:70px;
+
+}
+
+section h2::after{
+
+    content:"";
+
+    position:absolute;
+
+    width:80px;
+
+    height:5px;
+
+    border-radius:20px;
+
+    left:50%;
+
+    bottom:-18px;
+
+    transform:translateX(-50%);
+
+    background:var(--primary-gradient);
+
+}
+
+
+/*==========================================================
+                    TEXT SELECTION
+==========================================================*/
+
+::selection{
+
+    background:var(--primary-green);
+
+    color:white;
+
+}
+
+
+/*==========================================================
+                    SCROLLBAR
+==========================================================*/
+
+::-webkit-scrollbar{
+
+    width:10px;
+
+}
+
+::-webkit-scrollbar-track{
+
+    background:#dfe8e4;
+
+}
+
+::-webkit-scrollbar-thumb{
+
+    background:var(--primary-gradient);
+
+    border-radius:30px;
+
+}
+
+::-webkit-scrollbar-thumb:hover{
+
+    background:var(--dark-green);
+
+}
+
+
+/*==========================================================
+                    FADE-IN ANIMATION
+==========================================================*/
+
+.fade-up{
+
+    opacity:0;
+
+    transform:translateY(50px);
+
+    transition:1s;
+
+}
+
+.fade-up.active{
+
+    opacity:1;
+
+    transform:translateY(0);
+
+}
+
+
+/*==========================================================
+                    UTILITIES
+==========================================================*/
+
+.text-center{
+
+    text-align:center;
+
+}
+
+.mt-2{
+
+    margin-top:20px;
+
+}
+
+.mt-3{
+
+    margin-top:30px;
+
+}
+
+.mt-5{
+
+    margin-top:50px;
+
+}
+html,
+body {
+    overflow-x: hidden;
+}
+
+@media (max-width: 768px) {
+
+    .hero {
+        flex-direction: column;
+        text-align: center;
+    }
+
+    .hero-text,
+    .hero-image {
+        width: 100%;
+    }
 }
