+
+.market-tab-btn.active{
+
+    background:var(--primary-green);
+
+    color:white;
+
+    border-color:var(--primary-green);
+
+}
+
+.weather-hero{
+
+    background:var(--primary-gradient);
+
+    border-radius:var(--radius-large);
+
+    padding:40px;
+
+    color:white;
