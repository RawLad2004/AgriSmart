+/*==========================================================
+        AGRISMART DASHBOARD — extends variables.css
+        Link this AFTER variables.css, navbar.css not needed
+==========================================================*/
+
+:root{
+
+    --panel-bg:rgba(255,255,255,.06);
+    --panel-border:rgba(255,255,255,.12);
+    --sidebar-width:260px;
+    --topbar-height:80px;
+
+}
+
+
+/*==========================================================
+                    APP SHELL
+==========================================================*/
+
+.app-shell{
+
+    display:grid;
+
+    grid-template-columns:var(--sidebar-width) 1fr;
+
+    min-height:100vh;
+
+    background:var(--dark-blue);
+
+}
+
+
+/*==========================================================
+                    SIDEBAR
+==========================================================*/
+
+.sidebar{
+
+    background:linear-gradient(180deg,#072E12,#0B5D1E 40%,#0F3D57);
+
+    padding:30px 20px;
+
+    display:flex;
+
+    flex-direction:column;
+
+    gap:8px;
+
+}
+
+.sidebar .logo{
+
+    margin-bottom:40px;
+
+    padding-left:8px;
+
+}
+
+.sidebar .as-logo{
+
+    width:44px;
+
+    height:44px;
+
+    border-radius:50%;
+
+    background-color:#ffffff;
+
+    background-image:url('../images/logo-icon.png');
+
+    background-size:75%;
+
+    background-repeat:no-repeat;
+
+    background-position:center;
+
+    box-shadow:0 4px 12px rgba(0,0,0,.2);
+
+    flex-shrink:0;
+
+}
+
+.sidebar .letter-a,
+.sidebar .letter-s{
+
+    display:none;
+
+}
+
+.sidebar .logo h2{
+
+    color:white;
+
+}
+
+.sidebar-link{
+
+    display:flex;
+
+    align-items:center;
+
+    gap:14px;
+
+    padding:14px 16px;
+
+    border-radius:var(--radius-medium);
+
+    color:rgba(255,255,255,.75);
+
+    font-weight:600;
+
+    transition:var(--transition-fast);
+
+}
+
+.sidebar-link i{
+
+    width:20px;
+
+    text-align:center;
+
+}
+
+.sidebar-link:hover{
+
+    background:rgba(255,255,255,.08);
+
+    color:white;
+
+}
+
+.sidebar-link.active{
+
+    background:var(--electric-blue);
+
+    color:white;
+
+    box-shadow:var(--glow-blue);
+
+}
+
+.sidebar-bottom{
+
+    margin-top:auto;
+
+}
+
+
+/*==========================================================
+                    MAIN AREA
+==========================================================*/
+
+.main-area{
+
+    background:var(--off-white);
+
+    min-height:100vh;
+
+    min-width:0;
+
+}
+
+
+/*==========================================================
+                    TOPBAR
+==========================================================*/
+
+.topbar{
+
+    height:var(--topbar-height);
+
+    display:flex;
+
+    align-items:center;
+
+    justify-content:space-between;
+
+    padding:0 40px;
+
+    background:white;
+
+    box-shadow:var(--shadow-small);
+
+    position:sticky;
+
+    top:0;
+
+    z-index:100;
+
+}
+
+.topbar h1{
+
+    font-size:1.4rem;
+
+}
+
+.topbar-user{
+
+    display:flex;
+
+    align-items:center;
+
+    gap:14px;
+
+}
+
+.topbar-user .avatar{
+
+    width:42px;
+
+    height:42px;
+
+    border-radius:50%;
+
+    background:var(--primary-gradient);
+
+    color:white;
+
+    display:flex;
+
+    align-items:center;
+
+    justify-content:center;
+
+    font-weight:700;
+
+}
+
+
+/*==========================================================
+                    CONTENT PADDING
+==========================================================*/
+
+.dashboard-content{
+
+    padding:40px;
+
+}
+
+
+/*==========================================================
+                    STAT CARDS
+==========================================================*/
+
+.stat-grid{
+
+    display:grid;
+
+    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
+
+    gap:25px;
+
+    margin-bottom:40px;
+
+}
+
+.stat-card{
+
+    background:white;
+
+    border-radius:var(--radius-large);
+
+    padding:28px;
+
+    box-shadow:var(--shadow-small);
+
+    transition:var(--transition-normal);
+
+    border-left:5px solid var(--primary-green);
