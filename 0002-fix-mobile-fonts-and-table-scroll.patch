+    --white:#FFFFFF;
+    --off-white:#F8FBFA;
+
+    --light-grey:#EEF4F3;
+    --grey:#B0BEC5;
+    --dark-grey:#546E7A;
+
+    --text-color:#263238;
+
+
+    /*======================================================
+                        GRADIENTS
+    ======================================================*/
+
+    --primary-gradient:
+    linear-gradient(
+    135deg,
+    #0B5D1E 0%,
+    #2E8B57 40%,
+    #0F3D57 75%,
+    #00B7FF 100%);
+
+    --green-gradient:
+    linear-gradient(
+    135deg,
+    #0B5D1E,
+    #2E8B57,
+    #7ED957);
+
+    --blue-gradient:
+    linear-gradient(
+    135deg,
+    #0F3D57,
+    #006994,
+    #00B7FF);
+
+    --glass-gradient:
+    linear-gradient(
+    rgba(255,255,255,.15),
+    rgba(255,255,255,.05));
+
+
+    /*======================================================
+                        SHADOWS
+    ======================================================*/
+
+    --shadow-small:
+    0 5px 15px rgba(0,0,0,.08);
+
+    --shadow-medium:
+    0 12px 30px rgba(0,0,0,.12);
+
+    --shadow-large:
+    0 20px 50px rgba(0,0,0,.18);
+
+    --glow-green:
+    0 0 25px rgba(46,139,87,.35);
+
+    --glow-blue:
+    0 0 30px rgba(0,183,255,.30);
+
+
+    /*======================================================
