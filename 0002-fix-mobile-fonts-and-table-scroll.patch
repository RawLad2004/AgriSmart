+    transform:translateY(-6px);
+
+    box-shadow:var(--shadow-medium);
+
+}
+
+.stat-card .stat-label{
+
+    color:var(--dark-grey);
+
+    font-size:.9rem;
+
+    font-weight:600;
+
+    text-transform:uppercase;
+
+    letter-spacing:1px;
+
+}
+
+.stat-card .stat-value{
+
+    font-family:var(--heading-font);
+
+    font-size:2.2rem;
+
+    font-weight:700;
+
+    color:var(--dark-green);
+
+    margin-top:8px;
+
+}
+
+
+/*==========================================================
+                    PANELS
+==========================================================*/
+
+.panel{
+
+    background:white;
+
+    border-radius:var(--radius-large);
+
+    padding:30px;
+
+    box-shadow:var(--shadow-small);
+
+    margin-bottom:30px;
+
+}
+
+.panel-header{
+
+    display:flex;
+
+    align-items:center;
+
+    justify-content:space-between;
+
+    margin-bottom:25px;
+
+}
+
+.panel-header h2{
+
+    text-align:left;
+
+    font-size:1.3rem;
+
+    margin:0;
+
+}
+
+
+/*==========================================================
+                    DATA TABLE
+==========================================================*/
+
+.table-scroll{
+
+    width:100%;
+
+    overflow-x:auto;
+
+    -webkit-overflow-scrolling:touch;
+
+}
+
+table.data-table{
+
+    width:100%;
+
+    min-width:560px;
+
+    border-collapse:collapse;
+
+}
+
+.data-table th{
+
+    text-align:left;
+
+    padding:14px 16px;
+
+    font-size:.85rem;
+
+    text-transform:uppercase;
+
+    letter-spacing:.5px;
+
+    color:var(--dark-grey);
+
+    white-space:nowrap;
+
+    border-bottom:2px solid var(--light-grey);
+
+}
+
+.data-table td{
+
+    padding:16px;
+
+    white-space:nowrap;
+
+    border-bottom:1px solid var(--light-grey);
+
+    color:var(--text-color);
+
+}
+
+.data-table tr:hover td{
+
+    background:var(--off-white);
+
+}
+
+.badge{
+
+    display:inline-block;
+
+    padding:5px 14px;
+
+    border-radius:20px;
+
+    font-size:.8rem;
+
+    font-weight:700;
+
+    background:var(--light-green);
+
+    color:var(--dark-green);
+
+}
+
+
+/*==========================================================
+                    EMPTY STATE
+==========================================================*/
+
+.empty-state{
+
+    text-align:center;
+
+    padding:60px 20px;
+
+    color:var(--dark-grey);
+
+}
+
+.empty-state i{
+
+    font-size:2.5rem;
+
+    color:var(--grey);
+
+    margin-bottom:20px;
+
+}
+
+
+/*==========================================================
+                    FORMS
+==========================================================*/
+
+.form-group{
+
+    margin-bottom:22px;
+
+}
+
+.form-group label{
+
+    display:block;
+
+    font-weight:600;
+
+    margin-bottom:8px;
+
+    color:var(--text-color);
+
+}
+
+.form-group input,
+.form-group select,
+.form-group textarea{
+
+    width:100%;
+
+    padding:14px 18px;
+
+    border:2px solid var(--light-grey);
