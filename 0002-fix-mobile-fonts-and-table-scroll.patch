+    font-size:3.5rem;
+
+    font-weight:700;
+
+    line-height:1;
+
+}
+
+.weather-hero .wh-desc{
+
+    text-transform:capitalize;
+
+    margin-top:8px;
+
+    opacity:.95;
+
+}
+
+.weather-hero .wh-icon{
+
+    width:100px;
+
+    height:100px;
+
+}
+
+.weather-meta-grid{
+
+    display:grid;
+
+    grid-template-columns:repeat(auto-fit,minmax(100px,1fr));
+
+    gap:20px;
+
+    text-align:center;
+
+}
+
+.weather-meta-grid div{
+
+    background:rgba(255,255,255,.12);
+
+    border-radius:var(--radius-medium);
+
+    padding:14px 10px;
+
