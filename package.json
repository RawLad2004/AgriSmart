{
  "name": "agrova-web",
  "version": "0.1.0",
  "private": true,
  "description": "AGROVA / AgriSmart web app (static site + Supabase)",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\"",
    "serve": "npx --yes serve ."
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
